{"ast":null,"code":"export default {\n  name: 'HomeView'\n};","map":{"version":3,"names":["name"],"sources":["src/views/HomeView.vue"],"sourcesContent":["<template>\r\n  <div class=\"home\">\r\n    <div class=\"hero\">\r\n      <div class=\"hero-content\">\r\n        <h1 class=\"hero-title\">🎉 SSM + Vue 前后端整合实验</h1>\r\n        <p class=\"hero-subtitle\">Spring MVC + Spring + MyBatis 与 Vue.js 前后端分离项目</p>\r\n        <div class=\"hero-buttons\">\r\n          <router-link to=\"/user\" class=\"btn-hero\">开始体验 →</router-link>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"features\">\r\n      <div class=\"feature-card\">\r\n        <div class=\"feature-icon\">🚀</div>\r\n        <h3>前后端分离</h3>\r\n        <p>前端使用 Vue.js，后端使用 SSM 框架，独立开发，独立部署</p>\r\n      </div>\r\n      <div class=\"feature-card\">\r\n        <div class=\"feature-icon\">📡</div>\r\n        <h3>RESTful API</h3>\r\n        <p>后端提供标准 RESTful 接口，返回 JSON 格式数据</p>\r\n      </div>\r\n      <div class=\"feature-card\">\r\n        <div class=\"feature-icon\">🗄️</div>\r\n        <h3>数据库集成</h3>\r\n        <p>使用 MyBatis 操作 MySQL 数据库，实现数据持久化</p>\r\n      </div>\r\n      <div class=\"feature-card\">\r\n        <div class=\"feature-icon\">🌐</div>\r\n        <h3>跨域支持</h3>\r\n        <p>配置跨域过滤器，支持前后端不同端口通信</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'HomeView'\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.home {\r\n  min-height: calc(100vh - 70px);\r\n}\r\n\r\n.hero {\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  padding: 80px 40px;\r\n  text-align: center;\r\n  color: white;\r\n}\r\n\r\n.hero-content {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.hero-title {\r\n  font-size: 48px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.hero-subtitle {\r\n  font-size: 20px;\r\n  margin-bottom: 40px;\r\n  opacity: 0.95;\r\n}\r\n\r\n.btn-hero {\r\n  display: inline-block;\r\n  background: white;\r\n  color: #667eea;