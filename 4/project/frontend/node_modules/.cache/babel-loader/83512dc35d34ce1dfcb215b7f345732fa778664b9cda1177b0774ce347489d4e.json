{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'UserInfo',\n  data() {\n    return {\n      userInfo: null,\n      userList: [],\n      loading: true\n    };\n  },\n  mounted() {\n    this.fetchUserInfo();\n    this.fetchUserList();\n  },\n  methods: {\n    async fetchUserInfo() {\n      try {\n        const response = await axios.get('http://localhost:8080/api/user/info');\n        if (response.data.code === 200) {\n          this.userInfo = response.data.data;\n        }\n      } catch (error) {\n        console.error('获取用户信息失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async fetchUserList() {\n      try {\n        const response = await axios.get('http://localhost:8080/api/user/list');\n        if (response.data.code === 200) {\n          this.userList = response.data.data;\n        }\n      } catch (error) {\n        console.error('获取用户列表失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","userInfo","userList","loading","mounted","fetchUserInfo","fetchUserList","methods","response","get","code","error","console"],"sources":["src/views/UserInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-info\">\r\n    <h1>用户信息</h1>\r\n    <div v-if=\"loading\">加载中...</div>\r\n    <div v-else-if=\"userInfo\">\r\n      <p>姓名：{{ userInfo.name }}</p>\r\n      <p>年龄：{{ userInfo.age }}</p>\r\n      <p>邮箱：{{ userInfo.email }}</p>\r\n    </div>\r\n    <div v-else>暂无数据</div>\r\n    \r\n    <h2>用户列表</h2>\r\n    <ul>\r\n      <li v-for=\"user in userList\" :key=\"user.id\">\r\n        {{ user.username }} - {{ user.email }}\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'UserInfo',\r\n  data() {\r\n    return {\r\n      userInfo: null,\r\n      userList: [],\r\n      loading: true\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchUserInfo()\r\n    this.fetchUserList()\r\n  },\r\n  methods: {\r\n    async fetchUserInfo() {\r\n      try {\r\n        const response = await axios.get('http://localhost:8080/api/user/info')\r\n        if (response.data.code === 200) {\r\n          this.userInfo = response.data.data\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户信息失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async fetchUserList() {\r\n      try {\r\n        const response = await axios.get('http://localhost:8080/api/user/list')\r\n        if (response.data.code === 200) {\r\n          this.userList = response.data.data\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户列表失败:', error)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAqBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,aAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAF,cAAA;MACA;QACA,MAAAG,QAAA,SAAAV,KAAA,CAAAW,GAAA;QACA,IAAAD,QAAA,CAAAR,IAAA,CAAAU,IAAA;UACA,KAAAT,QAAA,GAAAO,QAAA,CAAAR,IAAA,CAAAA,IAAA;QACA;MACA,SAAAW,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAR,OAAA;MACA;IACA;IACA,MAAAG,cAAA;MACA;QACA,MAAAE,QAAA,SAAAV,KAAA,CAAAW,GAAA;QACA,IAAAD,QAAA,CAAAR,IAAA,CAAAU,IAAA;UACA,KAAAR,QAAA,GAAAM,QAAA,CAAAR,IAAA,CAAAA,IAAA;QACA;MACA,SAAAW,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}