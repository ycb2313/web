{"ast":null,"code":"import axios from 'axios';\n\n// 后端完整地址\nconst BACKEND_URL = 'http://localhost:8080/ssm-backend-1.0-SNAPSHOT';\nexport default {\n  data() {\n    return {\n      userInfo: null,\n      userList: []\n    };\n  },\n  methods: {\n    async fetchUserInfo() {\n      try {\n        const res = await axios.get(BACKEND_URL + '/api/user/info');\n        if (res.data.code === 200) {\n          this.userInfo = res.data.data;\n        }\n      } catch (error) {\n        console.error('获取用户信息失败:', error);\n      }\n    },\n    async fetchUserList() {\n      try {\n        const res = await axios.get(BACKEND_URL + '/api/user/list');\n        if (res.data.code === 200) {\n          this.userList = res.data.data;\n        }\n      } catch (error) {\n        console.error('获取用户列表失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","BACKEND_URL","data","userInfo","userList","methods","fetchUserInfo","res","get","code","error","console","fetchUserList"],"sources":["src/views/UserInfo.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h1>用户信息</h1>\r\n    <button @click=\"fetchUserInfo\">获取用户信息</button>\r\n    <div v-if=\"userInfo\">\r\n      <p>姓名：{{ userInfo.name }}</p>\r\n      <p>年龄：{{ userInfo.age }}</p>\r\n      <p>邮箱：{{ userInfo.email }}</p>\r\n    </div>\r\n\r\n    <h2>用户列表</h2>\r\n    <button @click=\"fetchUserList\">获取用户列表</button>\r\n    <ul v-if=\"userList.length > 0\">\r\n      <li v-for=\"user in userList\" :key=\"user.id\">\r\n        {{ user.username }} - {{ user.email }}\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios'\r\n\r\n// 后端完整地址\r\nconst BACKEND_URL = 'http://localhost:8080/ssm-backend-1.0-SNAPSHOT'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      userInfo: null,\r\n      userList: []\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchUserInfo() {\r\n      try {\r\n        const res = await axios.get(BACKEND_URL + '/api/user/info')\r\n        if (res.data.code === 200) {\r\n          this.userInfo = res.data.data\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户信息失败:', error)\r\n      }\r\n    },\r\n    async fetchUserList() {\r\n      try {\r\n        const res = await axios.get(BACKEND_URL + '/api/user/list')\r\n        if (res.data.code === 200) {\r\n          this.userList = res.data.data\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户列表失败:', error)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAqBA,OAAAA,KAAA;;AAEA;AACA,MAAAC,WAAA;AAEA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,cAAA;MACA;QACA,MAAAC,GAAA,SAAAP,KAAA,CAAAQ,GAAA,CAAAP,WAAA;QACA,IAAAM,GAAA,CAAAL,IAAA,CAAAO,IAAA;UACA,KAAAN,QAAA,GAAAI,GAAA,CAAAL,IAAA,CAAAA,IAAA;QACA;MACA,SAAAQ,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAE,cAAA;MACA;QACA,MAAAL,GAAA,SAAAP,KAAA,CAAAQ,GAAA,CAAAP,WAAA;QACA,IAAAM,GAAA,CAAAL,IAAA,CAAAO,IAAA;UACA,KAAAL,QAAA,GAAAG,GAAA,CAAAL,IAAA,CAAAA,IAAA;QACA;MACA,SAAAQ,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}